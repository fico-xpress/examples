.SUFFIXES: .bim .mos .java .class

ALL=batch2 dataafterexec datafromc datainout datatoc dataafterexec.class datafromj.class datatoj.class exitvalue

all: $(ALL)

.c:
	$(CC) -g -I$(XPRESSDIR)/include $(CFLAGS) $(LDFLAGS) $< -o $* -L$(XPRESSDIR)/lib -lxprm

.mos.bim:
	mosel compile -g $*

.java.class:	
	javac -classpath $(XPRESSDIR)/lib/xprm.jar:. $*.java

clean:
	rm -f $(ALL) *.o *.bim *.class
