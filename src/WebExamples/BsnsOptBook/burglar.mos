model 'burglar'
  uses "mmxprs"

  declarations
    NItems=8                   ! Number of items
    WTMAX= 102                 ! Maximum weight
    RItems=1..NItems
    V: array(RItems) of real   ! Value of items
    W: array(RItems) of real   ! Weight of items
    x: array(RItems) of mpvar  ! 1 if we take item i; 0 otherwise
  end-declarations

 ! Item 1   2   3   4   5   6   7   8
  V::[15,100, 90, 60, 40, 15, 10, 1]
  W::[2, 20, 20, 30, 40, 30, 60, 10]

 ! Objective: maximise the value 
  ValMax:= sum(i in RItems) V(i)*x(i)
 
 ! Weight restriction
  Wmax:= sum(i in RItems) W(i)*x(i)<= WTMAX  

 ! All x are 0/1
  forall(i in RItems) x(i) is_binary  

 (! Optional: export to matrix file in MPS format
  loadprob(ValMax)
  writeprob("burglar.mps","")
 !)

 ! Solve the problem
  maximise(ValMax)
  writeln("Solution: Value=", getobjval)
  write("Selected items: ")
  forall(i in RItems | x(i).sol=1) write(i, " ")
  writeln
end-model
