model 'simple1'
  uses "mmxprs"

  forward procedure printsol(msg: string)

  declarations
    w,x,y,z: mpvar                ! Decision variables as given in example
  end-declarations

  Profit:= 4*w + 3*x + 2*y + 5*z  ! Objective: total profit

  C1:= 2*w + x + 2*y + z<= 500    ! First constraint
  C2:= 2*w + 3*x + 2*z<= 460      ! Second constraint
  C3:= x + 4*y<= 420              ! Third constraint

 ! Solve the problem
  maximise(Profit)
  printsol("Original problem")

 ! Additional constraint
  C4:= w + 2*x + y +z <= 340

 ! Re-solve the problem
  maximise(Profit)
  printsol("Additional constraint")

 ! Modify a constraint
  C2:= 1.5*w + 2*x + 2*z<= 460

 ! Re-solve the problem
  maximise(Profit)
  printsol("Modified constraint")

 ! Solution printing
  procedure printsol(msg: string)
    writeln("***", msg)
    writeln("Solution: ", getobjval)
    writeln("  w=", w.sol, " x=", x.sol, " y=", y.sol, " z=", z.sol)
  end-procedure

end-model
