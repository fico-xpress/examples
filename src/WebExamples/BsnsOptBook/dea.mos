model 'dea'
  uses "mmxprs"

  declarations
    UNITS: set of string                 ! Set of locations
    OUTPUTS: set of string               ! Set of products
    VAL: array(UNITS,OUTPUTS) of real    ! Sales values
    COST: array(UNITS) of real           ! Total costs per location
    COEF: array(OUTPUTS) of real         ! Sales/total_cost(u)
  end-declarations

  VAL::(['Paris','London','Bonn'],['A','B','C'])[50,50,50,50,100,40,100,90,60]
  COST::(['Paris','London','Bonn'])[110,150,200]
 
  declarations
    w: array(OUTPUTS) of mpvar          ! Weights
  end-declarations

  forall(u in UNITS) do
    writeln("****Solving for ", u)
   ! Calculate coefficients
    forall(j in OUTPUTS) COEF(j):=VAL(u,j)/COST(u)

   ! Objective: Maximise efficiency for unit u
    Effcy:=sum(j in OUTPUTS) COEF(j)*w(j)   

  ! Efficiency must not exceed 1
    forall(i in UNITS)
      Cstr(i):= sum(j in OUTPUTS) VAL(i,j)*w(j)<= COST(i)
  ! Lower limit on weights
    forall(j in OUTPUTS) Lim(j):=w(j)>= 0.001                     

    maximise(Effcy)
    writeln("Solution: Efficiency(", u, ")=", getobjval)
    forall(i in UNITS-{u}) writeln("  ", i, ":", Cstr(i).act/COST(i))
    forall(j in OUTPUTS) writeln("  ", j, ":", w(j).sol)
  end-do
end-model
