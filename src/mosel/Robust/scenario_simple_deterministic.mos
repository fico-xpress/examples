model Scenario
 uses "mmxprs"                    ! Load the optimizer library

 declarations
  x, y : mpvar
 end-declarations 

 Scenario1 := 1 * x + 2 * y <= 1
 Scenario2 := 3 * x + 1 * y <= 1
 Scenario3 := 3 * x + 2 * y <= 1

 maximize(x+y)   

 writeln("x = ", getsol(x), "  y = ", getsol(y))

end-model
