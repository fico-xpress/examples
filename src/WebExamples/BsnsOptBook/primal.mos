model 'primal'
  uses "mmxprs"

  declarations
    x1,x2,x3: mpvar           ! Three decision variables
  end-declarations

  Obj:= 2*x1 + 3*x2 + x3      ! Objective function

  C1:= 2*x1 + x2 + x3<= 20    ! First constraint
  C2:= x1 + 2*x2<= 30         ! Second constraint

  maximise(Obj)
  writeln("Solution: ", getobjval)
  writeln("  x1=", x1.sol, " x2=", x2.sol, " x3=", x3.sol)
  writeln("  Dual values: C1=", C1.dual, " C2=", C2.dual)
end-model
