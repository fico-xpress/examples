model 'calves'
  uses "mmxprs"

  declarations
    c: mpvar               ! Number of calves
    p: mpvar               ! Number of pigs
  end-declarations

  Money:= c + p<= 3.5      ! Must stay within limit
  Ret:= 3*c + 2*p          ! Objective: maximise return

  c is_integer; c<=2
  p is_integer; p<=2

  maximise(Ret)
  writeln("Solution: Return=", getobjval)
  writeln("Number of calves=", c.sol, " pigs=", p.sol)

end-model
