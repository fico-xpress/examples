model 'network'
  uses "mmxprs"

  declarations
    INODES=1..7                              ! Nodes with outflow
    NODES=1..10                              ! All nodes
    x: array(INODES,NODES) of mpvar          ! Flows on arcs
  end-declarations

 ! Objective: minimise total cost of flows
  Cost:= 2*x(1,3) + 2*x(1,4) + 3*x(2,4) + 5*x(2,5) + 2*x(3,4) + 5*x(3,8) +
        4*x(4,5) + 2*x(4,7) + 3*x(5,10) + 3*x(6,3) + 5*x(6,8) +
        2*x(6,9) + 3*x(7,6) + 2*x(7,9) + 5*x(7,10)

 ! Flow conservation constraints
  A1:=x(1,3)+x(1,4)=10                       ! Outflow from source 1
  A2:=x(2,4)+x(2,5)=10                       ! Outflow from source 2
  A3:=x(3,4)+x(3,8)-x(1,3)-x(6,3)=0          ! Balance at node 3
  A4:=x(4,5)+x(4,7)-x(1,4)-x(2,4)-x(3,4)=0   ! Balance at node 4
  A5:=x(5,10)-x(2,5)-x(4,5)=0                ! Balance at node 5
  A6:=x(6,3)+x(6,8)+x(6,9)-x(7,6)=0          ! Balance at node 6
  A7:=x(7,6)+x(7,9)+x(7,10)-x(4,7)=0         ! Balance at node 7
  A8:=x(3,8)+x(6,8)=5                        ! Flow into sink 8
  A9:=x(6,9)+x(7,9)=10                       ! Flow into sink 9
  A10:=x(7,10)+x(5,10)=5                     ! Flow into sink 10

  minimise(Cost)
  writeln("Solution: Total cost=", getobjval)
  forall(i in INODES,j in NODES | x(i,j).sol>0) 
    writeln(i,"->",j,": ", x(i,j).sol)

end-model
