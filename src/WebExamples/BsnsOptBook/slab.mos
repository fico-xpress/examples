model 'slab'
  uses "mmxprs"

  declarations
    R=1..36                                    ! Set of slabs
    SGROUP: array(RG:range) of set of integer  ! Groups to inspect
    NEIGHB: array(RN:set of integer) of set of integer  ! Neighbours of slabs
    d: array(R) of mpvar                       ! Damaged slabs
    lift: array(RN) of mpvar                   ! Lifted slabs
  end-declarations

  SGROUP::(1..5)[{2,3,4}, {7,16,17,18}, {10,11,12}, {13,14}, {25,34,33,32}]
  NEIGHB(2):= {1,3,11}
  NEIGHB(3):= {2,14,12}
  NEIGHB(4):= {3,5,13}
  NEIGHB(7):= {6,8,16}
  NEIGHB(16):= {7,15,17,25}
  NEIGHB(17):= {8,16,18,26}
  NEIGHB(18):= {9,17,27}
  NEIGHB(10):= {1,11,19}
  NEIGHB(11):= {2,10,12,20}
  NEIGHB(12):= {3,11,13,21}
  NEIGHB(13):= {4,12,14,22}
  NEIGHB(14):= {5,13,15,23}
  NEIGHB(25):= {16,24,26,34}
  NEIGHB(34):= {25,33,35}
  NEIGHB(33):= {24,32,24}
  NEIGHB(32):= {23,31,33}

 ! Objective: minimise total damage caused by lifting slabs
  Damage:=sum(i in R) d(i)

 ! At least one slab in every group must be lifted
  forall(g in RG) sum(s in SGROUP(g)) lift(s) >=1 
   
 ! Damage caused to neighbours by lifting a slab
  forall(g in RG,s in SGROUP(g))
    sum(n in NEIGHB(s)) d(n) - NEIGHB(s).size*lift(s) >= 0

 ! Any lifted slab is damaged
  forall(s in RN) lift(s) <= d(s)

  forall(i in R) d(i) is_binary
  forall(i in RN) lift(i) is_binary
 
  minimise(Damage)
  writeln("Solution: Damaged slabs=", getobjval)
  forall(g in RG)
    writeln("  Group ", g, ": lift: ", getsol(sum(s in SGROUP(g)) s*lift(s)), 
      " damaged:", union(s in SGROUP(g) | d(s).sol>0) {s})
   writeln("  Others:  ", union(s in R-RN | d(s).sol>0) {s})
end-model
