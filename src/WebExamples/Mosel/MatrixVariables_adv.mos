(!******************************************************
   Mosel Example Problems
   ======================

   file MatrixVariables_adv.mos
   ````````````````````````````
   Improved version of model 'MatrixVariables_std.mos'.
   -- Defining constraints over a 2-dimensional array of variables --

   (c) 2019-2026 Fair Isaac Corporation
       author: S.Heipcke
*******************************************************!)
model "Matrix Variables"

    !S:IMPORT
    uses "mmetc","mmsystem","mmxprs"

    parameters
        DATA_FILE_PREFIX = "00"
    end-parameters
    writeln("#E:IMPORT")

    writeln("#S:READ")
    declarations
        T:range
        P:range
        V: array(P) of integer
        S: array(T) of integer
    end-declarations
(!
    initializations from "mmetc.diskdata:"
        S as "sparse,skiph,data/" + DATA_FILE_PREFIX + "_H_MatrixVariables_S.csv"
    end-initializations

    initializations from "mmetc.diskdata:"
        V as "sparse,skiph,data/" + DATA_FILE_PREFIX + "_H_MatrixVariables_V.csv"
    end-initializations
!)
   ! Same as previous lines:
    diskdata(ETC_SPARSE+ETC_SKIPH, DATA_FILE_PREFIX + "_H_MatrixVariables_S.csv", S)
    diskdata(ETC_SPARSE+ETC_SKIPH, DATA_FILE_PREFIX + "_H_MatrixVariables_V.csv", V)

    declarations
        q: array(T,P) of mpvar ! separately declared to wait until P and T are finalized
    end-declarations
    writeln("#E:READ")

    writeln("#S:PROC")
    forall(t in T)
        sum(p in P) q(t, p) * V(p) <= S(t)

    loadprob(0)
    writeln("#E:PROC")

end-model
