   Mosel Example Problems
   ====================== 

   file ProductsMachines_adv.mos
   ```````````````````````````````
   Improved version of model 'ProductsMachines_std.mos'.
   -- Multiple conditions on loop over block of statements --
 
   (c) 2019-2026 Fair Isaac Corporation
       author: S.Heipcke
*******************************************************!)
model "Products and Machines"

    !S:IMPORT
    uses "mmetc","mmsystem","mmxprs"

    parameters
        DATA_FILE_PREFIX = "00"
    end-parameters
    writeln("#E:IMPORT")

    writeln("#S:READ")
    declarations
        PRODS, MACH: range
        z: dynamic array(PRODS,MACH) of mpvar
        y: dynamic array(PRODS,MACH) of mpvar
        K: array(PRODS,MACH) of integer
        T: array(MACH) of integer 
        U: array(PRODS) of integer 
    end-declarations
(!
    initializations from "mmetc.diskdata:"
        T as "sparse,skiph,data/" + DATA_FILE_PREFIX + "_H_ProductsMachines_T.csv"
    end-initializations

    initializations from "mmetc.diskdata:"
        U as "sparse,skiph,data/" + DATA_FILE_PREFIX + "_H_ProductsMachines_U.csv"
    end-initializations

    initializations from "mmetc.diskdata:"
        K as "sparse,skiph,data/" + DATA_FILE_PREFIX + "_H_ProductsMachines_K.csv"
    end-initializations
   !)
   ! Same as previous lines:
    diskdata(ETC_SPARSE+ETC_SKIPH, DATA_FILE_PREFIX + "_H_ProductsMachines_T.csv", T) 
    diskdata(ETC_SPARSE+ETC_SKIPH, DATA_FILE_PREFIX + "_H_ProductsMachines_U.csv", U) 
    diskdata(ETC_SPARSE+ETC_SKIPH, DATA_FILE_PREFIX + "_H_ProductsMachines_K.csv", K) 
    writeln("#E:READ")

    writeln("#S:PROC")
    MACH3:=union(m in MACH | 3*T(m)<13) {m}
    forall(p in PRODS, m in MACH3 | K(p,m)=1) do
        create(z(p,m))
        create(y(p,m))
        y(p,m) is_binary
        z(p,m) <= U(p)
    end-do

    loadprob(0)
    writeln("#E:PROC")

    writeln("#S:TEST")
    forall(p in PRODS, m in MACH3 | K(p,m)=1) do
        writeln(p, " ", m)
    end-do
    writeln("#E:TEST")
end-model
