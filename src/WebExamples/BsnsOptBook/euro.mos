model 'euro'
  uses "mmxprs"

  declarations
    R=1..4                   ! Set of investments
    Y: array(R) of real      ! Yield of investments
    C: array(R) of real      ! Cost er investment
    d: array(R) of mpvar     ! Whether to select an investment
  end-declarations

  Y::[16,22,12,8]
  C::[5,7,4,3]

 ! Objective: maximise total yield
  Yield:= sum(i in R) Y(i)*d(i)

 ! Limit on the amount of capital to invest 
  MaxSpend:= sum(i in R) C(i)*d(i)<=14

  forall(i in R) d(i) is_binary

 ! Solve the problem
  maximise(Yield)
  writeln("Solution: Yield=", getobjval)
  write("Chosen investments:")
  forall(i in R | d(i).sol>0) write(" ",i)
  writeln
end-model
