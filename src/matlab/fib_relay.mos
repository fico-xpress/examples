model "fib_relay"                              
 function fibonacci(i:integer):integer         
  initializations to "matlab.mws:"             
    i                                          
  end-initializations                          

  initializations from "matlab.mws:"           
   returned as "fibonacci(i)"                  
  end-initializations                          
 end-function                                  

 forall(i in 1..10) do                         
  writeln("fibonacci(", i, ")=", fibonacci(i)) 
 end-do                                        
end-model                                      
