model fracprog
 uses "mmxprs", "mmxnlp"

 declarations
   R=1..2
   y: array(R) of mpvar           ! Decision variables for LP reformulation
   w: mpvar
   x: array(R) of mpvar           ! Decision variables of original problem
   LPprob, NLprob: mpproblem      ! Problem definitions
 end-declarations

 ! Reformulation as a linear problem
 with LPprob do
  y(1)+y(2)-w <=0
  y(2)+2*w = 1

  setparam("XPRS_VERBOSE", true)     ! Display solver log
  minimize(y(1)+w)

  writeln("LP reformulation:")
  writeln("y1=", y(1).sol, " y2=", y(2).sol, " w=", w.sol)
  x1:=y(1).sol/w.sol; x2:=y(2).sol/w.sol
  writeln("x1=", x1, " x2=", x2, " z=", (x1+1)/(x2+2))
 end-do

 ! Original nonlinear formulation
 with NLprob do
  x(1)+x(2) <= 1

  setparam("XNLP_VERBOSE", true)     ! Display solver log
  setparam("XNLP_SOLVER", 0)         ! Use Xpress SLP solver
  minimize((x(1)+1)/(x(2)+2))

  writeln("NLP formulation:")
  writeln("x1=", x(1).sol, " x2=", x(2).sol, " z=", getobjval)
 end-do

end-model
