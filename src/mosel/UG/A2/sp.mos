model sp
 declarations
  TT: array(1..2, 1..3, 1..4) of integer
 end-declarations

 TT:: [111, 112, 113, 114,
       121, 122, 123, 124,
       131, 132, 133, 134,
       211, 212, 213, 214,
       221, 222, 223, 224,
       231, 232, 233, 234]

 writeln("TT(1,1,1)= ", TT(1,1,1))
 writeln("TT(2,1,3)= ", TT(2,1,3))
 writeln("TT(2,3,4)= ", TT(2,3,4))

end-model
