model 'burgap'
  uses "mmxprs"

  declarations
    RC=1..3                   ! Set of containers
    RI=1..8                   ! Set of items
    d: array(RC,RI) of mpvar  ! 'delta' variable equals 1 if item assigned
                              !  to container
    P: array(RC,RI) of real   ! Profit per item per container
    W: array(RI) of real      ! Volume data for each item
  end-declarations

  P::[10,80,50,30,30,10,8,1,
      15,70,70,60,35,12,6,2,
      9,80,60,50,35,8,9,1]
  W::[2,20,20,30,40,30,60,10]

 ! Objective function: maximise profit
  Profit:= sum(i in RC,j in RI) P(i,j) * d(i,j)

 ! Each item is assigned to exactly one container
  forall(j in RI) Conv(j):= sum(i in RC) d(i,j)=1

 ! Volume occupied must not exceed limits
  forall(i in RC) Lim(i):=sum(j in RI)W(j)*d(i,j)<=90

  forall(i in RC,j in RI) d(i,j) is_binary

 ! Solve the problem
  maximise(Profit)
  writeln("Solution: Profit=", getobjval)
  forall(i in RC) do
    write("  Container ", i, ": ")
    forall(j in RI | d(i,j).sol=1) write(j, " ")
    writeln("(Used capacity: ", Lim(i).act, ")")
  end-do

end-model
