model Careful
 uses "mmrobust"                    ! Load the robust library

 declarations
  x, y: mpvar
  e, f : uncertain
 end-declarations

 x*e <= 1
 y*f <= 1

 e >= 0
 f >= 0
 e+f <= 1
 
 maximize(x+y)

 writeln("x = ", getsol(x), "  y = ", getsol(y))

end-model
