*********************************************************************!)
model 'blendx'
  uses "mmxprs", "mmetc"

  declarations
    ORETYPE: set of string          ! Types of ore

    ore: array(ORETYPE) of mpvar    ! Quantity of each ore to purchase

    COST: array(ORETYPE) of real    ! Cost per tonne of ores
    AVAIL: array(ORETYPE) of real   ! Availability of ores
    GRADE: array(ORETYPE) of real   ! Quality of ores
  end-declarations

! Read data from a CSV format file
  initializations from "mmetc.diskdata:"
    [GRADE,COST,AVAIL] as "csv;skiph;blendx.csv"
  end-initializations

(! Alternative form:
  diskdata(ETC_IN+ETC_CSV+ETC_SKIPH, "blendx.csv", [GRADE,COST,AVAIL])
!)

(! Read data from a text file in Mosel data format
  initializations from "blendx.dat"
    [GRADE,COST,AVAIL] as "ore_data"
  end-initializations
!)
 ! Objective function: maximise (Revenue - Costs)
  Profit:= sum(j in ORETYPE)(125 - COST(j))*ore(j)   

 ! Grade of blend must not exceed upper limit
  QualMax:= sum(j in ORETYPE)(5.0 - GRADE(j))*ore(j) >= 0

 ! Grade of blend must not exceed lower limit
  QualMin:= sum(j in ORETYPE)(GRADE(j) - 4.0)*ore(j) >= 0

 ! Do not exceed quantity of ores available
  forall(j in ORETYPE)
    limit(j):= ore(j)<= AVAIL(j)

 ! Solve the problem
  maximise(Profit)
  writeln("Solution: Profit=", getobjval)
  writeln("Purchase quantities:")
  forall(j in ORETYPE) writeln("  ", j, ": ", ore(j).sol)

end-model
