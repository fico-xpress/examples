model testinit
uses "meminit"

parameters
 MEMDAT=''              ! memory location of data
 MEMSIZ=0               ! size of the data block (nb of integers)
end-parameters

declarations
 a:array(1..20) of integer
end-declarations

 writeln("Data located at ",MEMDAT," contains ",MEMSIZ," integers")
 meminit(a,MEMDAT,MEMSIZ)
 writeln("a=",a)
end-model
