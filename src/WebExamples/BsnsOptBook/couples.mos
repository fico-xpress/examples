*********************************************************************!)

model 'couples'
  uses "mmxprs"

  declarations
    MEN=['Carl', 'Philip', 'Ray', 'Roland', 'Simon']
    WOMEN=['Kathy', 'Margaret', 'Marie', 'Olive', 'Vanessa']
    WINES=['Chianti', 'Liebfrauenmilch', 'Riesling', 'Soave', 'Spumante']
    DAYS=['Mon','Tue','Wed','Thu','Fri']
    R=1..MEN.size
    SM,SF,SW,SD: set of string
    wife: array(SM,SF) of mpvar    ! if male has wife
    wine: array(SM,SW) of mpvar    ! if male drinks a wine
    nite: array(SM,SD) of mpvar    ! if male drinks on a night
  end-declarations

  forall(f in WOMEN)
    Spouse1(f):=sum(m in MEN) wife(m,f)=1  ! Each man has a wife
  forall(m in MEN)
    Spouse2(m):=sum(f in WOMEN) wife(m,f)=1

  forall(w in WINES)
    Drink1(w):=sum(m in MEN) wine(m,w)=1   ! Each wine is drunk by one man
  forall(m in MEN)
    Drink2(m):=sum(w in WINES) wine(m,w)=1

  forall(n in DAYS)
    Night1(n):=sum(m in MEN) nite(m,n)=1   ! Each night is used by one man
  forall(m in MEN)
    Night2(m):=sum(n in DAYS) nite(m,n)=1

  ! Constraints fixing variables from conditions (a), (b), (c), (e)
  Fix1:=nite('Philip','Wed')+wine('Simon','Soave')+nite('Simon','Mon')+
        nite('Simon','Tue')+wife('Simon','Margaret')+wine('Simon','Spumante')+
	wife('Ray','Olive') = 0
  Fix2:=wife('Philip','Marie')+nite('Carl','Wed') = 2

  forall(m in SM-{'Simon'})
    Condb(m):=nite(m,'Fri')<=1-wine(m,'Soave')    ! Condition from (b)

  ! Conditions from (c)
  forall(m in {'Carl','Simon'})  ! condc0(m=1,5):wine(m,5)<1-wife(m,2)
    Condc0(m):=wine(m,'Spumante')<=1-wife(m,'Margaret')
  forall(m in SM-{'Simon'})
    Condc1(m):=sum(n in R) n*nite('Simon',DAYS(n)) -
               sum(n in R) n*nite(m,DAYS(n))-1 <= 3-3*wine(m,'Spumante')
  forall(m in SM-{'Simon'})
    Condc2(m):=sum(n in R) n*nite('Simon',DAYS(n)) -
               sum(n in R) n*nite(m,DAYS(n))-1 >= 5*wine(m,'Spumante')-5
  forall(m in SM-{'Simon'})
    Condc3(m):=sum(n in R) n*nite('Simon',DAYS(n)) -
               sum(n in R) n*nite(m,DAYS(n))-2 <= 2-2*wife(m,'Margaret')
  forall(m in SM-{'Simon'})
    Condc4(m):=sum(n in R) n*nite('Simon',DAYS(n)) -
               sum(n in R) n*nite(m,DAYS(n))-2 >= 6*wife(m,'Margaret')-6

  forall(m in MEN)
    Cond1(m):=wife(m,'Kathy')<=1-nite(m,'Tue')    ! Conditions from (d)
  forall(m in MEN)
    Cond2(m):=wife(m,'Kathy')=wine(m,'Chianti')

  forall(m in MEN)
    Conde(m):=wife(m,'Olive')=nite(m,'Fri')       ! Condition from (e)

  forall(m in MEN,f in WOMEN) wife(m,f) is_binary
  forall(m in MEN,w in WINES) wine(m,w) is_binary
  forall(m in MEN,n in DAYS) nite(m,n) is_binary

 ! Solving: Just get feasible
  minimise(0)
  forall(m in MEN)
   writeln(m, " + ",WOMEN(round(getsol(sum(i in R)i*wife(m,WOMEN(i)).sol)) ),
    " on ", DAYS(round(getsol(sum(i in R)i*nite(m,DAYS(i)).sol))),
    " drink ", WINES(round(getsol(sum(i in R)i*wine(m,WINES(i)).sol))))
end-model
