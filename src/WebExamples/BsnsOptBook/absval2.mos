    limitations under the License.

*********************************************************************!)

model 'absval2'
  uses "mmxnlp"

  declarations
    B1 = 3                       ! Bound on x1
    B2 = 4                       ! Bound on x2
    A = 10                       ! Upper bound on the abs. value expression

    x1, x2: mpvar                ! Decision variables
    z: mpvar                     ! Objective function variable
  end-declarations

  x1 <= B1
  x2 <= B2
  z = x1-2*x2
  z is_free
  abs(z) <= A
  
  setparam("XPRS_verbose", true)      
  maximise(abs(z))               ! Solve the problem as MIP
  writeln("Solution: ", getobjval)
  writeln("x1=", x1.sol, ", x2=", x2.sol, ", |x1-2*x2|=", abs(z.sol))
 
end-model
