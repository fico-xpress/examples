*********************************************************************!)

model 'absval'
  uses "mmxprs"

  declarations
    B1= 3                        ! Bound on x1
    B2= 4                        ! Bound on x2
    A= 10                        ! Upper bound on the abs. value expression

    x1, x2: mpvar                ! Decision variables
    aP: mpvar                    ! The a+ variable
    aM: mpvar                    ! The a- variable
    delta: mpvar                 ! Whether x2 is positive or negative
  end-declarations

  Profit:= aP + aM               ! Objective function

  Coupling:= x1 -2*x2 = aP - aM  ! Reformulation of |x1-2*x2| 
  C1:= aP<= A*delta              ! The restriction on a+
  C2:= aM<= A*(1-delta)          ! The restriction on a-

  delta is_binary
  x1<= B1
  x2<= B2
 
  maximise(Profit)               ! Solve the problem

  writeln("Solution: ", getobjval)
  writeln("x1=", x1.sol, ", x2=", x2.sol, ", |x1-2*x2|=", abs(getsol(x1-2*x2)))
  writeln("aux. variables: delta=", delta.sol, ", aP=", aP.sol, ", aM=", aM.sol)
end-model
