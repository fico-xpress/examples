       author: S. Heipcke, Jun. 2023
*******************************************!)
package versionedpkg
 version 1.0

!@mc.version.since 1.0.0
 public procedure showpkgver
   writeln("Using version ", getparam("model_version"), " of package 'versionedpkg'.")
 end-procedure
 
end-package
