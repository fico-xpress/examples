model 'prodx'
  uses "mmxprs"

  declarations
    PRODS=1..3                       ! Products
    RES=1..2                         ! Resources
    REQ: array(RES,PRODS) of real    ! Required machine hours
    PC: array(PRODS) of real         ! Profit contribution per product
  end-declarations

  REQ::[2.2, 1.8, 1.9,
        2.4, 2.0, 2.1]
  PC::[24.7, 22.4, 19.7]

  declarations
    a,b,c: mpvar     
  end-declarations

 ! Objective: maximise total profit
  Profit:= PC(1)*a + PC(2)*b + PC(3)*c

 ! Limits on resource availability
  M1:= REQ(1,1)*a + REQ(1,2)*b + REQ(1,3)*c<= 8
  M2:= REQ(2,1)*a + REQ(2,2)*b + REQ(2,3)*c<= 10

 ! Solve the problem
  maximise(Profit)
  writeln("Solution: Profit=", getobjval)
  writeln("  a=", a.sol, " b=", b.sol, " c=", c.sol)
end-model
