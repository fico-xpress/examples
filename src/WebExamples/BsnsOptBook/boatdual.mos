model 'boatdual'
  uses "mmxprs"

  declarations
    y1,y2,y3,y4: mpvar   ! 4 variables to correspond to the 4 constraints in Boat
  end-declarations

  Obj:= 350*y1 + 200*y2 + 1400*y4   ! Objective uses as coefficients the
                                    ! RHS values from Boat

  C1:= y1 + y2 - y3 + 4*y4 >= 800   ! These two constraints arise from the
  C2:= y1 + y3 + 3*y4 >= 600        ! two variables in Boat

  minimise(Obj)
  writeln("Solution: ", getobjval)
  writeln("y1=", y1.sol, "y2=", y2.sol, "y3=", y3.sol, "y4=", y4.sol)
end-model
