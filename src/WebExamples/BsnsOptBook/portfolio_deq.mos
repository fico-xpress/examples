(!*********************************************************************
   Mosel Example Problems
   ======================

   file portfolio_deq.mos
   ``````````````````````  
   Multi-stage Stochastic Portfolio Investment Model (DEQ) with 
   NA constraints solved by a scenario approach
   
     Example discussed in section 11.3.2.1 of
     J. Kallrath: Business Optimization Using Mathematical Programming -
     An Introduction with Case Studies and Solutions in Various Algebraic 
     Modeling Languages. 2nd edition, Springer Nature, Cham, 2021 

   author: S. Heipcke, October 2020

   based on the GAMS implementation in Portfolio_DEQ.gms
     by J.Kallrath and T.Lohmann 2011

   -- A decision maker has to determine the optimal investment levels in
      various investment opportunities subject to uncertain returns. At
      predetermined intervals, the assets can be redistributed, based on
      the returns realized to date. The objective is to meet a certain
      investment goal at the end of planning horizon; falling short of
      the financial goal carries a penalty. 

   (c) Copyright 2020 Fair Isaac Corporation
  
    Licensed under the Apache License, Version 2.0 (the "License");
    you may not use this file except in compliance with the License.
    You may obtain a copy of the License at
 
       http://www.apache.org/licenses/LICENSE-2.0
 
    Unless required by applicable law or agreed to in writing, software
    distributed under the License is distributed on an "AS IS" BASIS,
    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
    See the License for the specific language governing permissions and
    limitations under the License.

*********************************************************************!)

model "portfolio_deq"
  uses "mmxprs"
  parameters
    LOADX = false        ! Whether to read solution for fixing 'x' variables
    SOLX = ""            ! Location from which to read solution
    OUTFILE = "res.txt"  ! Location for data + results output
    DISPLAY=true         ! Whether to display results
  end-parameters

  public declarations
    I: set of string                    ! Investments
    T: set of string                    ! Stages
    TL: list of string                  ! Ordered list of stages
    TT: set of string                   ! Stages with investment
    S: range                            ! Scenarios
    BDGT: real                          ! Budget
    CAP: real                           ! Capital target 
    H: dynamic array(S,S,T) of boolean  ! Scenario hierarchy (parent scenario relation) 
    HC: dynamic array(S,S,T) of boolean !  Representative scenario-scenario-stage mapping
    P: array(S) of real                 ! Scenario probability
    RET: dynamic array(S,I,T) of real   ! Return of investment i at begin of stage t in scenario s
    RExpanded: array(S,I,T) of real

    x: array(S,I,T) of mpvar            ! Amount of money invested in instrument i
    over: array(S) of mpvar             ! Capital in excess of the target CAP
    short: array(S) of mpvar            ! Capital short of the target CAP
    Wealth: linctr                      ! Objective 

    Solx: dynamic array(S,I,T) of real  ! Solution values for variables x
  end-declarations

!******** Input data ********

  I:= {'Stocks', 'Bonds'}
  BDGT:= 55; CAP:= 80
  NSCEN:=8; S:=1..NSCEN
  TL:= ['today','year-5','year-10','horizon']; T:=set(TL)
  TT:={'today','year-5','year-10'}
  H(1,2,'horizon'):=true  
  H(1,2,'horizon'):=true 
  H(1,3,'year-10'):=true 
  H(1,3,'horizon'):=true 
  H(1,5,'year-5'):=true 
  H(1,5,'year-10'):=true 
  H(1,5,'horizon'):=true 
  H(3,4,'horizon'):=true 
  H(5,6,'horizon'):=true 
  H(5,7,'year-10'):=true 
  H(5,7,'horizon'):=true 
  H(7,8,'horizon'):=true
  
 ! Build the representative scenario-scenario-stage map from parent scenario relation H
  forall(t in T) HC(1,1,t):= true     ! All stages have scenario 1
  ! Scenarios have only themselves as last stage scenarios (identical map)
  forall(rs,s in S | or(t in T ) H(rs,s,t))  do
     forall(t in T | H(rs,s,t)) HC(s,s,t):= H(rs,s,t)    
     forall(ss in S,t in T | HC(ss,rs,t) and not H(rs,s,t)) HC(ss,s,t) := true 
  end-do 
 ! We assume that all scenarios have the same probability
  forall(s in S) P(s) := 1/NSCEN

  RET::(1,'Stocks',['year-5','year-10','horizon'])[1.25, 1.25, 1.25]
  RET::(1,'Bonds',['year-5','year-10','horizon'])[1.14,1.14,1.14]
  RET(2,'Stocks','horizon'):=1.06
  RET(2,'Bonds','horizon'):=1.12
  RET::(3,'Stocks',['year-10','horizon'])[1.06, 1.25]
  RET::(3,'Bonds',['year-10','horizon'])[1.12, 1.14]
  RET(4,'Stocks','horizon'):=1.06
  RET(4,'Bonds','horizon'):=1.12
  RET::(5,'Stocks',['year-5','year-10','horizon'])[1.06, 1.25, 1.25]
  RET::(5,'Bonds',['year-5','year-10','horizon'])[1.12, 1.14, 1.14]
  RET(6,'Stocks','horizon'):=1.06
  RET(6,'Bonds','horizon'):=1.12
  RET::(7,'Stocks',['year-10','horizon'])[1.06, 1.25]
  RET::(7,'Bonds',['year-10','horizon'])[1.12, 1.14]
  RET(8,'Stocks','horizon'):=1.06
  RET(8,'Bonds','horizon'):=1.12  
 
 ! Return of investment i at the begin of stage t in scenario s
  forall(s in S, i in I, t in T) RExpanded(s,i,t):=sum(rs in S|HC(rs,s,t))RET(rs,i,t)

!******** Problem statement ********

 ! Objective: We assume an income of q+% = 1% over the excess, 
 ! while not meeting the goal would lead to borrowing at cost q-% = 4%.
  Wealth:= sum(s in S) P(s)*(over(s) - 4*short(s))

 ! The first-period constraint is simply to invest the initial budget
  forall(s in S) Budget(s):= sum(i in I) x(s,i,'today') = BDGT

 ! ROI in period t+1 from investment i in period t is reinvested in period t+1,
 ! or contributes to the final balance: CAP + over - short
 ! (This is a self-financing strategy)
  forall(s in S, ti in 1..TL.size-1 | TL(ti) in TT) Balance(s,TL(ti)):=
     sum(i in I) RExpanded(s,i,TL(ti+1))*x(s,i,TL(ti)) = 
      if(ti<TT.size, sum(i in I) x(s,i,TL(ti+1)), CAP + over(s) - short(s))  

 ! Non-anticipativity constraint for x - respect the tree structure
  forall(s in S, i in I, t in T) NA_X(s,i,t):= 
    x(s,i,t) = sum(rs in S | HC(rs,s,t)) x(rs,i,t) 

  if LOADX then
    initializations from SOLX
      Solx
    end-initializations
    if DISPLAY then writeln("Solx=", Solx); end-if
    forall(s in S, i in I, t in T | exists(Solx(s,i,t))) x(s,i,t)=Solx(s,i,t)
  end-if

 ! Solve the problem
 ! setparam("XPRS_verbose", true)
  maximize(Wealth)

  if getprobstat<>XPRS_OPT then
    exit(1)
  else
    if DISPLAY then
      writeln("Solution: ", getobjval)
      forall(t in TT, s in S )
        writeln(" ",t, ",s", s,"  ", x(s,'Stocks',t).sol, "  ", x(s,'Bonds',t).sol)
      forall(s in S ) writeln(" s",s, " short:", short(s).sol, " over:", over(s).sol)
    end-if
  end-if
! to indicate that the problem is infeasible, set the objective function to -inf
  
!  forall(s in S) writeln(over(s).sol, "  ", short(s).sol)

 ! Write data and result to the output file
  initializations to OUTFILE
    I T TL S RET RExpanded P BDGT CAP H HC 
    evaluation of getobjval as "Wealth"
  end-initializations
end-model  
